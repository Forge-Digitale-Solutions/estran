# HTTP with cache and the 31-day chunking guard
# --------------------------------------------------------------------------- #

def http_get(url: str, cache_key: str, use_cache: bool) -> bytes:
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, hashlib.sha256(cache_key.encode()).hexdigest() + ".json")
    if use_cache and os.path.exists(path):
        with open(path, "rb") as handle:
            return handle.read()
    request = urllib.request.Request(url, headers={"User-Agent": "estran-tides/1.0"})
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            payload = response.read()
    except urllib.error.HTTPError as error:
        die(f"HTTP {error.code} for {url}")
    except urllib.error.URLError as error:
        die(f"network error for {url}: {error.reason}")
    with open(path, "wb") as handle:
        handle.write(payload)
    return payload


def fetch_gauge_index(use_cache: bool) -> dict:
    payload = http_get(GAUGE_URL, "gauge-index", use_cache)
    return {str(entry["id"]): entry for entry in json.loads(payload)}


def fetch_gauge_detail(station: str, use_cache: bool) -> dict:
    payload = http_get(
        DETAIL_URL.format(station=station), f"detail-{station}", use_cache)
    return json.loads(payload)


def fetch_observations(station: str, source: int, start: datetime, end: datetime,
                       use_cache: bool) -> list:
    """Fetch one <=31-day window.

    REFMAR's ``dtEnd`` is **inclusive of the closing midnight** and exclusive of
    that day: ``dtStart=2025-01-01&dtEnd=2025-02-01`` returns 745 hourly rows,
    ``2025/01/01 00:00`` through ``2025/02/01 00:00``. The caller therefore
    passes an exclusive ``end`` and gets the half-open interval
    ``[start, end)``. The response must reach the closing midnight, otherwise
    the request was silently truncated (review Z20).
    """
    if end <= start:
        die(f"invalid window {start}..{end}")
    if (end - start).days > MAX_DAYS_PER_REQUEST:
        die(f"window {start}..{end} exceeds the silent {MAX_DAYS_PER_REQUEST}-day limit")

    # REFMAR's `dtEnd` is a day boundary: it returns rows up to the closing
    # midnight of that day. A window that ends mid-day (the last published
    # hour) must therefore ask for the following day.
    if end.hour == 0 and end.minute == 0 and end.second == 0:
        dt_end = end
    else:
        dt_end = end + timedelta(days=1)
    dt_end = dt_end.replace(hour=0, minute=0, second=0, microsecond=0)

    query = urllib.parse.urlencode({
        "sources": source,
        "dtStart": start.strftime("%Y-%m-%d"),
        "dtEnd": dt_end.strftime("%Y-%m-%d"),
    })
    url = OBS_URL.format(station=station) + "?" + query
    cache_key = f"obs-{station}-{source}-{start:%Y-%m-%d}-{dt_end:%Y-%m-%d}"
    payload = http_get(url, cache_key, use_cache)
    body = json.loads(payload)
    rows = body.get("data", body) if isinstance(body, dict) else body
    if not rows:
        return []

    points = [(parse_timestamp(row["timestamp"]), float(row["value"])) for row in rows]
    points.sort()

    # The 10-minute series can repeat a timestamp at a window edge; keep the
    # last value instead of counting it twice.
    deduplicated = {}
    for timestamp, value in points:
        deduplicated[timestamp] = value
    points = sorted(deduplicated.items())

    # Truncation guard: the last sample of the half-open hourly window must be
    # `end - 1 h`, and the series must start at the requested first hour. The
    # previous `end - 1 h` tolerance hid the 23-hour chunker loss (review Z20).
    if points[-1][0] < end - timedelta(hours=1):
        # A tail that is a documented source outage is not truncation; an
        # unexplained one still aborts (review Z20).
        if not gap_is_allowlisted(station, points[-1][0], end):
            die(
                f"truncated response for station {station} source {source} "
                f"{start:%Y-%m-%d}..{end:%Y-%m-%d}: last point {points[-1][0]:%Y-%m-%d %H:%M}, "
                f"expected {end - timedelta(hours=1):%Y-%m-%d %H:%M}")
    if points[0][0] > start:
        if not gap_is_allowlisted(station, start, points[0][0]):
            die(
                f"late response for station {station} source {source} "
                f"{start:%Y-%m-%d}..{end:%Y-%m-%d}: first point {points[0][0]:%Y-%m-%d %H:%M}")

    window = [(timestamp, value) for timestamp, value in points if start <= timestamp < end]
    return window


def fetch_range(station: str, source: int, start: str, end: str,
                use_cache: bool) -> tuple:
    """Fetch a range as consecutive <=31-day windows and de-duplicate.

    Returns ``(points, expected_hours)`` where ``expected_hours`` is the exact
    number of hours in the half-open range ``[start, end + 1 day)``. Each window
    is a full 31-day span: the previous ``+ 1 day`` cursor skipped the 23 hours
    after every closing midnight (review Z20).
    """
    cursor = parse_day(start)
    stop = parse_day(end) + timedelta(days=1)
    last_available = LAST_AVAILABLE.get(station)
    if last_available is not None:
        stop = min(stop, last_available + timedelta(hours=1))
    points: dict = {}
    expected = 0
    while cursor < stop:
        span_end = min(cursor + timedelta(days=MAX_DAYS_PER_REQUEST), stop)
        expected += int((span_end - cursor).total_seconds() / 3600)
        for timestamp, value in fetch_observations(
                station, source, cursor, span_end, use_cache):
            points[timestamp] = value
        cursor = span_end
    return sorted(points.items()), expected



