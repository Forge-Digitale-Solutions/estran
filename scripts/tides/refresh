# Extrema
# --------------------------------------------------------------------------- #

def observed_extrema(points: list, tolerance_minutes: float = 6.0,
                     prominence: float = 0.30) -> list:
    """Local extrema of a 10-minute series, refined by a parabola.

    The validated 10-minute series still carries centimetre-scale wiggles, so
    extrema are detected on a 1-hour centred moving average and only kept when
    they stand at least ``prominence`` metres above the surrounding 3-hour
    minimum (or below the maximum). Without that filter a year of data yields
    ~2 500 "extrema" instead of the ~1 400 real tides.
    """
    if len(points) < 13:
        return []

    # Centred 7-point (1 h) moving average; None marks a gap.
    smoothed = []
    half = 3
    for index in range(len(points)):
        window = points[max(0, index - half): index + half + 1]
        if len(window) < 7:
            smoothed.append(None)
            continue
        span = (window[-1][0] - window[0][0]).total_seconds() / 3600
        if span > 1.5:
            smoothed.append(None)
            continue
        smoothed.append(sum(value for _, value in window) / len(window))

    events = []
    for index in range(3, len(points) - 3):
        current = smoothed[index]
        if current is None or smoothed[index - 1] is None or smoothed[index + 1] is None:
            continue
        previous, following = smoothed[index - 1], smoothed[index + 1]
        is_high = current > previous and current > following
        is_low = current < previous and current < following
        if not (is_high or is_low):
            continue

        # Prominence against the 3-hour neighbourhood.
        neighbourhood = [
            value for value in smoothed[max(0, index - 18): index + 19]
            if value is not None
        ]
        if len(neighbourhood) < 12:
            continue
        if is_high and current - min(neighbourhood) < prominence:
            continue
        if is_low and max(neighbourhood) - current < prominence:
            continue

        # Plateau centre: a broad tidal high can produce several local maxima
        # on the 1 h smoothed series (2023-11-05 at station 15 was flat from
        # 08:00 to 10:00). Keep the most extreme point within ±2 h, otherwise
        # the first wiggle is reported as an 80-minute timing error.
        search = range(max(3, index - 12), min(len(smoothed) - 3, index + 13))
        candidates = [(i, smoothed[i]) for i in search if smoothed[i] is not None]
        if not candidates:
            continue
        centre = max(candidates, key=lambda item: item[1])[0] if is_high \
            else min(candidates, key=lambda item: item[1])[0]
        # The 1 h smoothing shifts an asymmetric peak; refine on the raw
        # 10-minute series within ±1 h of the smoothed centre.
        raw_window = list(enumerate(points[max(0, centre - 6): centre + 7],
                                    start=max(0, centre - 6)))
        if len(raw_window) < 3:
            continue
        raw_index = (max if is_high else min)(
            raw_window, key=lambda item: item[1][1])[0]
        if raw_index <= 0 or raw_index >= len(points) - 1:
            continue
        previous, current, following = (
            points[raw_index - 1][1], points[raw_index][1], points[raw_index + 1][1])
        step = (points[raw_index + 1][0] - points[raw_index - 1][0]).total_seconds() / 2
        if step <= 0 or step > tolerance_minutes * 60 * 2:
            continue
        denominator = previous - 2 * current + following
        offset = 0.0 if denominator == 0 else 0.5 * (previous - following) / denominator
        offset = max(-0.5, min(0.5, offset))
        events.append({
            "time": points[raw_index][0] + timedelta(seconds=offset * step * 2),
            "height": current,
            "kind": "high" if is_high else "low",
        })

    # Drop duplicates that the smoothing window can create around flat peaks.
    deduplicated = []
    for event in events:
        if deduplicated and event["kind"] == deduplicated[-1]["kind"] and \
                abs((event["time"] - deduplicated[-1]["time"]).total_seconds()) < 3600:
            continue
        deduplicated.append(event)
    return deduplicated


def predicted_extrema(constants: dict, mean: float, speeds: dict,
                      start: datetime, end: datetime, step_minutes: int = 5) -> list:
    step = timedelta(minutes=step_minutes)
    samples = []
    cursor = start
    while cursor <= end:
        samples.append((cursor, predict(constants, mean, speeds, cursor)))
        cursor += step
    events = []
    for index in range(1, len(samples) - 1):
        previous, current, following = samples[index - 1], samples[index], samples[index + 1]
        is_high = current[1] > previous[1] and current[1] > following[1]
        is_low = current[1] < previous[1] and current[1] < following[1]
        if not (is_high or is_low):
            continue
        low, high = previous[0], following[0]
        for _ in range(60):
            third = (high - low) / 3
            left = low + third
            right = high - third
            left_value = predict(constants, mean, speeds, left)
            right_value = predict(constants, mean, speeds, right)
            if (left_value > right_value) == is_high:
                low = left
            else:
                high = right
        refined = low + (high - low) / 2
        events.append({
            "time": refined,
            "height": predict(constants, mean, speeds, refined),
            "kind": "high" if is_high else "low",
        })
    return events


def compare_extrema(observed: list, predicted: list, max_delta_minutes: float = 90.0) -> dict:
    errors = {"low": [], "high": []}
    height_errors = []
    matched = 0
    worst = None
    for event in observed:
        candidates = [other for other in predicted if other["kind"] == event["kind"]]
        if not candidates:
            continue
        nearest = min(candidates, key=lambda other: abs(
            (other["time"] - event["time"]).total_seconds()))
        delta = abs((nearest["time"] - event["time"]).total_seconds()) / 60
        if delta > max_delta_minutes:
            continue
        matched += 1
        errors[event["kind"]].append(delta)
        height_errors.append(abs(nearest["height"] - event["height"]))
        if worst is None or delta > worst["deltaMinutes"]:
            worst = {
                "kind": event["kind"],
                "observed": iso(event["time"]),
                "predicted": iso(nearest["time"]),
                "deltaMinutes": round(delta, 2),
            }

    def summary(values):
        return {
            "count": len(values),
            "medianMinutes": round(median(values), 2) if values else None,
            "p95Minutes": round(percentile(values, 0.95), 2) if values else None,
            "maxMinutes": round(max(values), 2) if values else None,
        }

    return {
        "observed": len(observed),
        "matched": matched,
        "unmatched": len(observed) - matched,
        "low": summary(errors["low"]),
        "high": summary(errors["high"]),
        "maxHeightErrorMeters": round(max(height_errors), 4) if height_errors else None,
        "p95HeightErrorMeters": round(percentile(height_errors, 0.95), 4) if height_errors else None,
        "worst": worst,
    }


