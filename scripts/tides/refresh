@dataclass
class QCReport:
    station: str
    window: str
    total: int = 0
    expected: int = 0
    rejected: dict = field(default_factory=dict)
    kept: int = 0
    coverage: float = 0.0
    max_gap_hours: float = 0.0
    datum_drift: float = 0.0
    failures: list = field(default_factory=list)
    gaps: list = field(default_factory=list)

    def reject(self, check: str, count: int) -> None:
        if count:
            self.rejected[check] = self.rejected.get(check, 0) + count

    def as_dict(self) -> dict:
        return {
            "window": self.window,
            "total": self.total,
            "expected": self.expected,
            "kept": self.kept,
            "rejected": self.rejected,
            "coverage": round(self.coverage, 4),
            "maxGapHours": round(self.max_gap_hours, 2),
            "datumStepMeters": round(self.datum_drift, 4),
            "gaps": self.gaps,
            "failures": self.failures,
        }


def gap_is_allowlisted(station: str, start: datetime, end: datetime) -> bool:
    """`true` when a source outage is documented with dates and a reason."""
    for entry in STATIONS.get(station, {}).get("allowedGaps", []):
        if entry["start"] <= start.strftime("%Y-%m-%d") and \
                end.strftime("%Y-%m-%d") <= entry["end"]:
            return True
    return False


def gap_details(points: list, station: str, threshold: float = QC_MAX_GAP_HOURS) -> list:
    """Gaps longer than `threshold`, with their dates and allowlist status."""
    details = []
    for index in range(1, len(points)):
        hours = (points[index][0] - points[index - 1][0]).total_seconds() / 3600
        if hours <= threshold:
            continue
        start, end = points[index - 1][0], points[index][0]
        details.append({
            "start": iso(start),
            "end": iso(end),
            "hours": round(hours, 2),
            "allowlisted": gap_is_allowlisted(station, start, end),
        })
    return details


def assert_gaps(points: list, station: str, label: str) -> None:
    """A gap > 1.5 h is fatal unless the station allowlists it (review Z20)."""
    details = gap_details(points, station)
    unexplained = [gap for gap in details if not gap["allowlisted"]]
    for gap in details:
        state = "allowlisted" if gap["allowlisted"] else "UNEXPLAINED"
        log(f"[{station}] {label}: gap {gap['hours']} h "
            f"{gap['start']}..{gap['end']} ({state})")
    if unexplained:
        die(
            f"station {station} {label}: {len(unexplained)} unexplained gap(s) > "
            f"{QC_MAX_GAP_HOURS} h; add a dated allowlist entry with a source reason")


def apply_qc(points: list, station: str, window: str, bounds: tuple,
             expected_hours: int) -> tuple:
    """Range / rate / spike / flatline / gap / coverage QC (docs §4.4)."""
    report = QCReport(
        station=station, window=window, total=len(points), expected=expected_hours)
    low, high = bounds

    # 0. Source gaps are measured on the **raw** series: a sample removed by the
    # rate or spike filter is not a source outage. A raw gap > 1.5 h aborts the
    # run unless the station documents it (review Z20).
    report.gaps = gap_details(points, station)
    raw_gaps = [
        (points[index][0] - points[index - 1][0]).total_seconds() / 3600
        for index in range(1, len(points))
    ]
    report.max_gap_hours = max(raw_gaps) if raw_gaps else 0.0
    for gap in report.gaps:
        if not gap["allowlisted"]:
            report.failures.append(
                f"gap of {gap['hours']:.1f} h > {QC_MAX_GAP_HOURS} h "
                f"({gap['start']}..{gap['end']}, unexplained)")

    # 1. Range.
    ranged = []
    dropped = 0
    for timestamp, value in points:
        if low <= value <= high:
            ranged.append((timestamp, value))
        else:
            dropped += 1
    report.reject("range", dropped)

    # 2. Rate of change on the hourly series.
    rated = []
    for index, (timestamp, value) in enumerate(ranged):
        if index == 0:
            rated.append((timestamp, value))
            continue
        previous_time, previous_value = ranged[index - 1]
        hours = (timestamp - previous_time).total_seconds() / 3600
        if hours <= 0:
            continue
        if abs(value - previous_value) / hours <= QC_MAX_RATE:
            rated.append((timestamp, value))
        else:
            dropped += 1
    report.reject("rate", len(ranged) - len(rated))

    # 3. Spike against the 3-point median.
    spiked = []
    for index, (timestamp, value) in enumerate(rated):
        if index == 0 or index == len(rated) - 1:
            spiked.append((timestamp, value))
            continue
        neighbourhood = [rated[index - 1][1], value, rated[index + 1][1]]
        if abs(value - median(neighbourhood)) > QC_SPIKE_METERS:
            dropped += 1
        else:
            spiked.append((timestamp, value))
    report.reject("spike", len(rated) - len(spiked))

    # 4. Flatline: >= 6 consecutive identical values.
    flat = []
    run_start = 0
    for index in range(1, len(spiked) + 1):
        if index < len(spiked) and spiked[index][1] == spiked[run_start][1]:
            continue
        run_length = index - run_start
        if run_length >= QC_FLATLINE_RUN:
            dropped += run_length
        else:
            flat.extend(spiked[run_start:index])
        run_start = index
    report.reject("flatline", len(spiked) - len(flat))

    # 5. Coverage. Gaps were measured on the raw series above; QC removals only
    # reduce the sample count, they are never interpolated.
    report.kept = len(flat)
    report.coverage = len(flat) / expected_hours if expected_hours else 0.0
    if report.coverage < QC_MIN_COVERAGE:
        report.failures.append(
            f"coverage {report.coverage:.1%} < {QC_MIN_COVERAGE:.0%}")

    return flat, report


# --------------------------------------------------------------------------- #
# Harmonic fit
# --------------------------------------------------------------------------- #

def load_speeds() -> dict:
    """Read the constituent table from Swift so the two cannot drift."""
    with open(SWIFT_SPEEDS, encoding="utf-8") as handle:
        source = handle.read()
    match = re.search(r"static let table: \[String: Double\] = \[(.*?)\n    \]",
                      source, re.S)
    if not match:
        die("cannot locate ConstituentSpeeds.table in TideStation.swift")
    table = {}
    for symbol, raw in re.findall(r'"([A-Z0-9]+)":\s*([0-9_.]+)', match.group(1)):
        table[symbol] = float(raw.replace("_", ""))
    missing = [symbol for symbol in CONSTITUENTS if symbol not in table]
    if missing:
        die(f"ConstituentSpeeds is missing {missing}")
    return table


def cholesky_solve(matrix: list, rhs: list) -> list:
    size = len(matrix)
    lower = [[0.0] * size for _ in range(size)]
    for row in range(size):
        for column in range(row + 1):
            total = matrix[row][column] - sum(
                lower[row][k] * lower[column][k] for k in range(column))
            if row == column:
                if total <= 0:
                    die("normal equations are not positive definite")
                lower[row][column] = math.sqrt(total)
            else:
                lower[row][column] = total / lower[column][column]
    intermediate = [0.0] * size
    for row in range(size):
        intermediate[row] = (
            rhs[row] - sum(lower[row][k] * intermediate[k] for k in range(row))
        ) / lower[row][row]
    solution = [0.0] * size
    for row in reversed(range(size)):
        solution[row] = (
            intermediate[row]
            - sum(lower[k][row] * solution[k] for k in range(row + 1, size))
        ) / lower[row][row]
    return solution


def fit_constituents(points: list, speeds: dict, compute_residuals: bool = True) -> dict:
    """Least squares for h(t) = Z0 + Σ H_i cos(ω_i t − g_i), t in hours since epoch."""
    symbols = list(CONSTITUENTS)
    omega = [math.radians(speeds[symbol]) for symbol in symbols]
    size = 1 + 2 * len(symbols)

    gram = [[0.0] * size for _ in range(size)]
    rhs = [0.0] * size

    for timestamp, value in points:
        hours = (timestamp - EPOCH).total_seconds() / 3600
        basis = [1.0]
        for angle in omega:
            phase = angle * hours
            basis.append(math.cos(phase))
            basis.append(math.sin(phase))
        for row in range(size):
            basis_row = basis[row]
            rhs[row] += basis_row * value
            gram_row = gram[row]
            for column in range(row, size):
                gram_row[column] += basis_row * basis[column]

    for row in range(size):
        for column in range(row):
            gram[row][column] = gram[column][row]
    # Tiny ridge for near-collinear long-period terms.
    for index in range(size):
        gram[index][index] += 1e-9

    solution = cholesky_solve(gram, rhs)

    constants = {}
    for index, symbol in enumerate(symbols):
        cosine = solution[1 + 2 * index]
        sine = solution[2 + 2 * index]
        amplitude = math.hypot(cosine, sine)
        phase = math.degrees(math.atan2(sine, cosine)) % 360.0
        constants[symbol] = {"amplitude": amplitude, "phaseDegrees": phase}

    return {
        "meanSeaLevel": solution[0],
        "constants": constants,
        "residuals": residuals(points, solution[0], constants, speeds)
        if compute_residuals else [],
    }


def residuals(points: list, mean: float, constants: dict, speeds: dict) -> list:
    symbols = list(constants)
    omegas = [math.radians(speeds[symbol]) for symbol in symbols]
    amplitudes = [constants[symbol]["amplitude"] for symbol in symbols]
    phases = [math.radians(constants[symbol]["phaseDegrees"]) for symbol in symbols]
    output = []
    for timestamp, value in points:
        hours = (timestamp - EPOCH).total_seconds() / 3600
        predicted = mean
        for omega, amplitude, phase in zip(omegas, amplitudes, phases):
            predicted += amplitude * math.cos(omega * hours - phase)
        output.append((timestamp, value - predicted))
    return output


def predict(constants: dict, mean: float, speeds: dict, timestamp: datetime) -> float:
    hours = (timestamp - EPOCH).total_seconds() / 3600
    height = mean
    for symbol, entry in constants.items():
        omega = math.radians(speeds[symbol])
        height += entry["amplitude"] * math.cos(
            omega * hours - math.radians(entry["phaseDegrees"]))
    return height


