def build_dataset(stations: list, year: int, revision: int,
                  swimming_ranges: dict) -> dict:
    by_id = {station["id"]: station for station in stations}
    spots = []
    for spot in SPOTS:
        station = by_id.get(spot["stationId"])
        if station is None:
            die(f"spot {spot['id']} references station {spot['stationId']}, "
                "which is not part of this run")
        swimming = swimming_ranges.get(spot["id"])
        if swimming is None:
            die(f"spot {spot['id']} has no swimming-range calibration")
        spots.append({
            "id": spot["id"],
            "stationId": spot["stationId"],
            "correction": {"lagMinutes": 0, "amplitudeFactor": 1.0},
            "correctionStatus": "none",
            "validation": "gauged",
            "uncertainty": {
                "timeMinutes": station["uncertainty"]["timeMinutes"],
                "heightMeters": station["uncertainty"]["heightMeters"],
                "basis": station["uncertaintyBasis"],
            },
            "swimmingRange": swimming,
        })

    coefficient_station = by_id.get("3")
    coefficient = {
        "stationId": "3" if coefficient_station else None,
        "divisor": COEFFICIENT_DIVISOR,
        # Z23: the Brest model is fitted but **not validated** against a
        # published Annuaire sample. SwimmingRule requires this flag, so fixing
        # the coefficient path cannot switch baignade on by accident.
        "validated": False,
        "validation": (
            "382 published 2025 high waters at Arcachon-Eyrac paired with the "
            "Brest model: bias +1.75 points, 37 % within +/-1, 57 % within "
            "+/-2, max 7 (target +/-1 for 90 %)."),
        "gateMarginPoints": 2,
        "nodalDrift": (
            "M2 nodal factor 0.963 (2025) -> 0.997 (2029); the fit averages "
            "0.985 over 2022-2026, i.e. +/-1.5 % around the fit mean, "
            "absorbed by u_h = 0.60 m and the 2-point gate margin."),
    }

    return {
        "schemaVersion": 6,
        "source": "REFMAR / Shom",
        "license": "Licence Ouverte 2.0",
        "licenseURL": LICENSE_URL,
        "sourceDatasets": SOURCE_DATASETS,
        "sourceLastUpdate": "2026-02-24",
        "retrievedAt": iso(datetime.now(UTC)),
        "official": False,
        "method": "least-squares harmonic analysis",
        "epoch": "2000-01-01T00:00:00Z",
        "datum": "zero_hydrographique",
        "units": "m",
        "nodalCorrections": False,
        "meanSpringRangeMethod": "2 * (M2 + S2) from the fitted constants",
        "constituents": CONSTITUENTS,
        "droppedConstituents": [],
        "generator": "scripts/tides/refresh",
        "coefficient": coefficient,
        "stations": stations,
        "spots": spots,
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--year", type=int, default=2026)
    parser.add_argument("--revision", type=int, default=1)
    parser.add_argument("--station", action="append", default=None,
                        help="restrict to a station id (repeatable)")
    parser.add_argument("--dry-run", action="store_true",
                        help="build and report, do not write the dataset")
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--out", default=None)
    arguments = parser.parse_args()

    use_cache = not arguments.no_cache
    speeds = load_speeds()
    log(f"loaded {len(speeds)} constituent speeds from Swift")

    selected = arguments.station or list(STATIONS)
    unknown = [station for station in selected if station not in STATIONS]
    if unknown:
        die(f"unknown station(s): {unknown}")

    index = fetch_gauge_index(use_cache)
    stations = []
    for station_id in selected:
        config = STATIONS[station_id]
        entry = index.get(station_id)
        if entry is None:
            die(f"station {station_id} is not in the REFMAR index")
        source4 = [stat for stat in entry.get("stats", []) if stat.get("source") == 4]
        if source4:
            LAST_AVAILABLE[station_id] = parse_iso(source4[-1]["last_date"])
        log(f"[{station_id}] state {entry['state']}, "
            f"source 4 through {source4[-1]['last_date'] if source4 else 'unknown'}")
        stations.append(run_station(station_id, config, speeds, use_cache, index))

    swimming_ranges = calibrate_swimming_ranges(stations, speeds)
    dataset = build_dataset(
        stations, arguments.year, arguments.revision, swimming_ranges)

    if arguments.dry_run:
        log("dry run: dataset not written")
        print(json.dumps(dataset, ensure_ascii=False, indent=2)[:2000])
        return

    os.makedirs(OUTPUT_DIR, exist_ok=True)
    output = arguments.out or os.path.join(
        OUTPUT_DIR, f"tide-model-{arguments.year}.{arguments.revision}.json")
    with open(output, "w", encoding="utf-8") as handle:
        json.dump(dataset, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
    log(f"wrote {os.path.relpath(output, REPO_ROOT)}")

    report = os.path.join(
        REPO_ROOT, "docs/data-sourcing",
        f"accuracy-{arguments.year}.{arguments.revision}.md")
    with open(report, "w", encoding="utf-8") as handle:
        handle.write(render_report(dataset, arguments.year, arguments.revision))
    log(f"wrote {os.path.relpath(report, REPO_ROOT)}")


def render_report(dataset: dict, year: int, revision: int) -> str:
    lines = [
        f"# Accuracy report — tide-model-{year}.{revision}",
        "",
        "Generated by `scripts/tides/refresh`. Held-out year is never in the fit.",
        "",
        "## Held-out year (2025)",
        "",
        "| Station | Fit | Test | n | RMSE (m) | Bias (m) | p95 \\|Δh\\| (m) | "
        "max under-pred. (m) | min over-pred. (m) | Low Δt med/p95/max (min) | "
        "High Δt med/p95/max (min) |",
        "|---|---|---|---|---|---|---|---|---|---|---|",
    ]
    for station in dataset["stations"]:
        accuracy = station["accuracy"]
        fit = ", ".join(f"{window['start']}→{window['end']}" for window in station["fitWindows"])
        test = f"{accuracy['testWindow']['start']}→{accuracy['testWindow']['end']}"
        low = accuracy["extrema"]["low"]
        high = accuracy["extrema"]["high"]
        lines.append(
            f"| **{station['id']}** {station['name']} | {fit} | {test} | "
            f"{accuracy['samples']} | {accuracy['rmseMeters']} | {accuracy['biasMeters']} | "
            f"{accuracy['p95HeightErrorMeters']} | "
            f"**{accuracy['maxUnderPredictionMeters']}** | "
            f"{accuracy['minOverPredictionMeters']} | "
            f"{low['medianMinutes']} / {low['p95Minutes']} / {low['maxMinutes']} | "
            f"{high['medianMinutes']} / {high['p95Minutes']} / {high['maxMinutes']} |")
    lines += [
        "",
        "`max under-prediction` is `max(pred − obs)` over the held-out year: the "
        "prediction was too **high**, the only direction that can fail the "
        "boating gate open. `min over-prediction` is the most negative residual, "
        "the safe direction.",
        "",
        "**RMSE is a series property (Z30).** The held-out year is one draw; a "
        "stormy winter can push it above 0.20 m without a regression. The rule "
        "is: LOYO median ≤ 0.20 m and no LOYO year above 0.22 m.",
        "",
    ]
    for station in dataset["stations"]:
        accuracy = station["accuracy"]
        series = accuracy.get("seriesRmse") or {}
        rmses = [
            entry["rmseMeters"] for entry in accuracy.get("leaveOneYearOut", [])
            if entry.get("rmseMeters") is not None
        ]
        if rmses and series:
            lines.append(
                f"- **{station['id']}**: 2025 {accuracy['rmseMeters']} m; LOYO "
                f"range {min(rmses):.4f}–{max(rmses):.4f}, median "
                f"{series['medianMeters']:.4f} — series rule "
                f"{'pass' if series['passed'] else 'FAIL'}.")
    lines += [
        "",
        "## Leave-one-year-out (Z27/Z29)",
        "",
        "A single neutral year does not bound the series: an anticyclonic winter "
        "makes the model run too high. For each year, the model is refitted "
        "without that year and evaluated on it. `u_h` must cover the worst "
        "leave-one-year-out under-prediction + 0.05 m.",
        "",
        "| Station | Year | n | RMSE (m) | Bias (m) | p95 \\|Δh\\| (m) | "
        "max under-pred. (m) | max \\|Δt\\| (min) |",
        "|---|---|---|---|---|---|---|---|",
    ]
    for station in dataset["stations"]:
        for entry in station["accuracy"].get("leaveOneYearOut", []):
            lines.append(
                f"| **{station['id']}** {station['name']} | {entry['year']} | "
                f"{entry['samples']} | {entry['rmseMeters']} | {entry['biasMeters']} | "
                f"{entry['p95HeightErrorMeters']} | **{entry['maxUnderPredictionMeters']}** | "
                f"**{entry['maxMinutes']}** |")
    lines += [
        "",
        "## Anomalous-year stress test (Z26)",
        "",
        "Fit on the pre-2025 windows only, predict the 2026 half-year. This is "
        "**not** a horizon measurement: January 2026 mean pressure at Arcachon "
        "was 1007.9 hPa against 1027.6 hPa in January 2022 (~+0.20 m of sea level "
        "from atmospheric loading), and January 2025 was neutral at 1016.8 hPa. "
        "A harmonic model does not predict weather; the bias below is the "
        "anomaly, not model drift. The horizon bounds astronomical decay "
        "(nodal, ±1.5 % over 2022→2029), not the annual dispersion that `u_h` "
        "carries.",
        "",
        "| Station | Fit | Stress window | n | RMSE (m) | Bias (m) | "
        "p95 \\|Δh\\| (m) | max under-pred. (m) | Low Δt max (min) | High Δt max (min) |",
        "|---|---|---|---|---|---|---|---|---|---|",
    ]
    for station in dataset["stations"]:
        forward = station["accuracy"].get("forwardTest")
        if not forward:
            lines.append(f"| **{station['id']}** {station['name']} | — | — | — | — | — | — | — | — | — |")
            continue
        fit = ", ".join(f"{window['start']}→{window['end']}" for window in forward["fitWindows"])
        window = f"{forward['testWindow']['start']}→{forward['testWindow']['end']}"
        lines.append(
            f"| **{station['id']}** {station['name']} | {fit} | {window} | "
            f"{forward['samples']} | {forward['rmseMeters']} | {forward['biasMeters']} | "
            f"{forward['p95HeightErrorMeters']} | {forward['maxUnderPredictionMeters']} | "
            f"{forward['extrema']['low']['maxMinutes']} | "
            f"{forward['extrema']['high']['maxMinutes']} |")

    lines += [
        "",
        "## QC",
        "",
        "| Station | Window | Kept | Coverage | Max gap (h) | Datum step (m) | Rejected |",
        "|---|---|---|---|---|---|---|",
    ]
    for station in dataset["stations"]:
        for report in station["qc"]:
            rejected = ", ".join(f"{key} {value}" for key, value in report["rejected"].items()) or "—"
            lines.append(
                f"| {station['id']} | {report['window']} | {report['kept']}/{report['expected']} | "
                f"{report['coverage']:.1%} | {report['maxGapHours']} | "
                f"{report['datumStepMeters']} | {rejected} |")
    lines += [
        "",
        "## Envelopes",
        "",
        "| Spot | u_t (min) | u_h (m) | Basis (generated) |",
        "|---|---|---|---|",
    ]
    for spot in dataset["spots"]:
        uncertainty = spot["uncertainty"]
        basis = uncertainty["basis"].replace("|", "\\|")
        lines.append(
            f"| {spot['id']} | {uncertainty['timeMinutes']} | "
            f"{uncertainty['heightMeters']} | {basis} |")
    calibration_year = next(
        (spot.get("swimmingRange", {}).get("calibration", {}).get("year")
         for spot in dataset["spots"] if spot.get("swimmingRange")), None)
    lines += [
        "",
        "## Swimming range calibration",
        "",
        f"Calibration year **{calibration_year}**: `T` is the local predicted "
        "daily range reached on the same number of days as the national "
        "coefficient reaches 100 at Brest. The number of qualifying days is "
        "specific to that year, not a constant. The grey band is `T ± 0.30 m`; "
        "no `low` is possible inside it.",
        "",
        "| Spot | Year | T (m) | lowBelow (m) | strongAt (m) | Coef ≥ 100 days |",
        "|---|---|---|---|---|---|",
    ]
    for spot in dataset["spots"]:
        swimming = spot.get("swimmingRange") or {}
        calibration = swimming.get("calibration") or {}
        lines.append(
            f"| {spot['id']} | {calibration.get('year')} | "
            f"{calibration.get('thresholdMeters')} | "
            f"{swimming.get('lowBelow')} | {swimming.get('strongAt')} | "
            f"{calibration.get('coefficientDaysAtOrAbove100')} |")
    lines += [
        "",
        "## Notes",
        "",
        "- **Z20**: each request is a full 31-day span with an exclusive `dtEnd`; "
        "a gap > 1.5 h aborts the run unless the station allowlists it with "
        "dates and a source reason.",
        "- **Z21**: `u_h` is one-sided (`max(pred − obs) + 0.05 m`), not "
        "`max |Δh|`. `maxAbsoluteErrorMeters` is information only and is never "
        "subtracted from a height.",
        "- **Z22**: D2 is a consistency rule — median ≤ 12 min, p95 ≤ 35 min, "
        "max |Δt| ≤ `u_t` − 10 min, |bias| ≤ 0.05 m, p95 |Δh| ≤ 0.40 m, "
        "max under-prediction ≤ `u_h` − 0.05 m. RMSE is a series property "
        "(Z30). The generator aborts if a declared envelope does not cover the "
        "measurement.",
        "- **Z23**: the national coefficient uses `range_Brest / 6.10 × 100`, "
        "clamped 20…120. The Brest model is **not validated** against a "
        "published Annuaire sample (`coefficient.validated = false`), so "
        "baignade stays `.dataUnavailable`.",
        "- **Z26**: the 2026-H1 stress test is an anomalous-pressure year, not a "
        "horizon measurement. Its bias is weather, not model drift.",
        "- **Z27**: `u_h` is sized on the leave-one-year-out maximum, not on the "
        "neutral 2025 year; the `basis` names the worst year.",
        "- **Z28**: `validUntil` is fit end + 3 years for all stations. The "
        "horizon bounds astronomical decay (nodal drift), not annual weather "
        "dispersion, which `u_h` carries. Regenerate the dataset once a year "
        "(BUILD.md).",
        "- **Z29**: `u_t` is sized on the leave-one-year-out max |Δt| + 10 min; "
        "the `basis` names the worst year. Extrema are detected on a 1 h "
        "smoothed series and plateau-centred on the raw 10-minute series. A "
        "4 cm plateau is still reported at its highest sample: the 2023-08-24 "
        "high at station 15 is such a plateau, and `u_t = 75` is kept because "
        "the 2023 low-water max is 63.21 min.",
        "- **Z30**: RMSE is a series property — LOYO median ≤ 0.20 m and no year "
        "above 0.22 m. The held-out year is one draw, not a regression test.",
        "- Extrema are compared against the validated 10-minute series "
        "(source 3), matched within 90 min of the observed extremum.",
        "",
    ]
    return "\n".join(lines)


if __name__ == "__main__":
    main()
