def height_stats(points: list, constants: dict, mean: float, speeds: dict) -> dict:
    """Signed height statistics against observations.

    `maxUnderPredictionMeters` is `max(pred - obs)`: the prediction was **too
    high**, which is the only direction that can fail the boating gate open.
    `minOverPredictionMeters` is the most negative residual (prediction too low,
    the safe direction). `maxAbsoluteErrorMeters` is information only and is
    never subtracted from a height (review Z21).
    """
    signed = [
        predict(constants, mean, speeds, timestamp) - observed
        for timestamp, observed in points
    ]
    if not signed:
        return {
            "samples": 0,
            "rmseMeters": None,
            "biasMeters": None,
            "p95HeightErrorMeters": None,
            "maxUnderPredictionMeters": None,
            "minOverPredictionMeters": None,
            "maxAbsoluteErrorMeters": None,
        }
    absolute = [abs(error) for error in signed]
    return {
        "samples": len(signed),
        "rmseMeters": round(math.sqrt(sum(error * error for error in signed) / len(signed)), 5),
        "biasMeters": round(sum(signed) / len(signed), 5),
        "p95HeightErrorMeters": round(percentile(absolute, 0.95), 4),
        "maxUnderPredictionMeters": round(max(max(signed), 0.0), 4),
        "minOverPredictionMeters": round(min(min(signed), 0.0), 4),
        "maxAbsoluteErrorMeters": round(max(absolute), 4),
    }


def extrema_metrics(station_id: str, constants: dict, mean: float, speeds: dict,
                    start: str, end: str, use_cache: bool) -> dict:
    """Extrema of the model against the validated 10-minute series (source 3)."""
    points, _ = fetch_range(station_id, 3, start, end, use_cache)
    assert_gaps(points, station_id, f"extrema {start}..{end}")
    observed = observed_extrema(points)
    predicted = predicted_extrema(
        constants, mean, speeds,
        parse_day(start), parse_day(end) + timedelta(days=1))
    return compare_extrema(observed, predicted)


def within_d2(stats: dict, extrema: dict, u_t: float, u_h: float) -> bool:
    """D2 consistency rule (review Z22), applied to a forward window."""
    if stats["rmseMeters"] is None:
        return False
    max_time = max(
        extrema["low"]["maxMinutes"] or 0.0,
        extrema["high"]["maxMinutes"] or 0.0)
    return (
        stats["rmseMeters"] <= 0.20
        and abs(stats["biasMeters"]) <= 0.05
        and stats["p95HeightErrorMeters"] <= 0.40
        and stats["maxUnderPredictionMeters"] <= u_h - 0.05
        and (extrema["low"]["medianMinutes"] or 0.0) <= 12
        and (extrema["low"]["p95Minutes"] or 0.0) <= 35
        and (extrema["high"]["medianMinutes"] or 0.0) <= 12
        and (extrema["high"]["p95Minutes"] or 0.0) <= 35
        and max_time <= u_t - 10
    )


def station_daily_ranges(station: dict, speeds: dict, year: int) -> dict:
    """Predicted daily tidal range for every day of `year`, in metres."""
    constants = {
        constituent["symbol"]: {
            "amplitude": constituent["amplitude"],
            "phaseDegrees": constituent["phaseDegrees"],
        }
        for constituent in station["constituents"]
    }
    mean = station["meanSeaLevel"]
    start = datetime(year, 1, 1, tzinfo=UTC)
    end = datetime(year + 1, 1, 1, tzinfo=UTC)
    ranges = {}
    day = start
    while day < end:
        values = []
        cursor = day
        while cursor < day + timedelta(days=1):
            values.append(predict(constants, mean, speeds, cursor))
            cursor += timedelta(minutes=10)
        ranges[day.date()] = max(values) - min(values)
        day += timedelta(days=1)
    return ranges


def calibrate_swimming_ranges(stations: list, speeds: dict, year: int = 2025,
                              margin: float = 0.30) -> dict:
    """Per-spot swimming thresholds from the **local predicted range**.

    `T` is the local daily range reached on the same number of days as the
    national coefficient reaches 100 at Brest. The grey band is `T ± margin`;
    `lowBelow = T - margin`, `strongAt = T + margin`. The generator refuses an
    empty or inverted band (review v11 / product decision).
    """
    by_id = {station["id"]: station for station in stations}
    if "3" not in by_id:
        die("swimming calibration needs the coefficient station 3")
    brest = station_daily_ranges(by_id["3"], speeds, year)
    national = {
        day: min(120, max(20, round(value / COEFFICIENT_DIVISOR * 100)))
        for day, value in brest.items()
    }
    coefficient_days = [day for day, coefficient in national.items() if coefficient >= 100]
    if not coefficient_days:
        die("swimming calibration: no day reaches coefficient 100")
    count = len(coefficient_days)

    ranges = {}
    for spot in SPOTS:
        station = by_id.get(spot["stationId"])
        if station is None:
            die(f"swimming calibration: spot {spot['id']} station is missing")
        daily = station_daily_ranges(station, speeds, year)
        ordered = sorted(daily.values(), reverse=True)
        if count > len(ordered):
            die(f"swimming calibration: {count} coefficient days > {len(ordered)} days")
        threshold = ordered[count - 1]
        low_below = round(threshold - margin, 2)
        strong_at = round(threshold + margin, 2)
        if low_below <= 0 or low_below >= strong_at:
            die(f"swimming calibration: invalid band for {spot['id']} "
                f"({low_below}..{strong_at}, T {threshold:.3f})")
        ranges[spot["id"]] = {
            "lowBelow": low_below,
            "strongAt": strong_at,
            "calibration": {
                "year": year,
                "coefficientDaysAtOrAbove100": count,
                "thresholdMeters": round(threshold, 3),
                "marginMeters": margin,
            },
        }
        log(f"[swim] {spot['id']}: T {threshold:.3f} m over {count} days, "
            f"lowBelow {low_below} m, strongAt {strong_at} m")

    return ranges


def run_station(station_id: str, config: dict, speeds: dict, use_cache: bool,
                index: dict, only: bool = False) -> dict:
    log(f"[{station_id}] {config['name']}")

    detail = fetch_gauge_detail(station_id, use_cache)
    bounds = (
        float(detail["npbma"]) - QC_RANGE_MARGIN,
        float(detail["nphma"]) + QC_RANGE_MARGIN,
    )
    log(f"[{station_id}] reference vertical {detail.get('verticalRef')} "
        f"npbma {detail['npbma']} nphma {detail['nphma']}")

    fit_points = []
    kept_by_window = []
    qc_reports = []
    for start, end in config["fit"]:
        raw, expected = fetch_range(station_id, 4, start, end, use_cache)
        kept, report = apply_qc(raw, station_id, f"{start}..{end}", bounds, expected)
        log(f"[{station_id}] fit {start}..{end}: {len(raw)}/{expected} raw -> "
            f"{len(kept)} kept ({report.coverage:.1%}), "
            f"max gap {report.max_gap_hours:.1f} h")
        fit_points.extend(kept)
        kept_by_window.append(((start, end), kept))
        qc_reports.append(report)

    failures = [failure for report in qc_reports for failure in report.failures]
    if failures:
        for failure in failures:
            log(f"[{station_id}]   QC: {failure}")
        die(f"station {station_id}: {len(failures)} QC failure(s); fix the data or "
            "document an allowlisted outage")

    if not fit_points:
        die(f"station {station_id}: no data survived QC")

    log(f"[{station_id}] fitting {len(CONSTITUENTS)} constituents on "
        f"{len(fit_points)} points…")
    fit = fit_constituents(fit_points, speeds)
    constants = fit["constants"]
    mean = fit["meanSeaLevel"]

    # Datum continuity: a datum jump is a *sustained* step, not seasonality.
    # Monthly medians swing by ±0.15 m with the seasonal cycle, so the check
    # compares consecutive half-year blocks; the threshold is the calibrated
    # QC_DATUM_DRIFT (docs §4.4 allows calibrating it on 2022-2025).
    half_year = {}
    for timestamp, residual in fit["residuals"]:
        key = (timestamp.year, 0 if timestamp.month <= 6 else 1)
        half_year.setdefault(key, []).append(residual)
    block_medians = [median(values) for _, values in sorted(half_year.items())]
    steps = [abs(block_medians[index] - block_medians[index - 1])
             for index in range(1, len(block_medians))]
    drift = max(steps) if steps else 0.0
    for report in qc_reports:
        report.datum_drift = drift
        if drift > QC_DATUM_DRIFT:
            report.failures.append(
                f"datum step {drift:.3f} m > {QC_DATUM_DRIFT:.2f} m between half-year blocks")
    log(f"[{station_id}] datum step {drift:.3f} m across {len(block_medians)} half-year blocks")
    if drift > QC_DATUM_DRIFT:
        die(f"station {station_id}: datum step {drift:.3f} m exceeds the calibrated "
            f"{QC_DATUM_DRIFT:.2f} m threshold")

    # Held-out accuracy on the test year.
    test_start, test_end = config["test"]
    test_points, test_expected = fetch_range(station_id, 4, test_start, test_end, use_cache)
    assert_gaps(test_points, station_id, f"test {test_start}..{test_end}")
    log(f"[{station_id}] test {test_start}..{test_end}: "
        f"{len(test_points)}/{test_expected} samples ({len(test_points) / test_expected:.1%})")
    stats = height_stats(test_points, constants, mean, speeds)
    log(f"[{station_id}] RMSE {stats['rmseMeters']} m, bias {stats['biasMeters']:+} m, "
        f"p95 |dh| {stats['p95HeightErrorMeters']} m, "
        f"max under-prediction {stats['maxUnderPredictionMeters']} m, "
        f"min over-prediction {stats['minOverPredictionMeters']} m")

    extrema = extrema_metrics(
        station_id, constants, mean, speeds, test_start, test_end, use_cache)
    log(f"[{station_id}] extrema: low median {extrema['low']['medianMinutes']} min / "
        f"p95 {extrema['low']['p95Minutes']} / max {extrema['low']['maxMinutes']}; "
        f"high median {extrema['high']['medianMinutes']} / "
        f"p95 {extrema['high']['p95Minutes']} / max {extrema['high']['maxMinutes']}")

    shipping = any(spot["stationId"] == station_id for spot in SPOTS)

    # Z27: leave-one-year-out. A single neutral year (2025) does not bound the
    # series: an anticyclonic winter makes the model run too high, the unsafe
    # direction for BoatingRule. For every year in the record, fit on the other
    # years and measure max(pred - obs) on the held-out year.
    yearly = {}
    for _, kept in kept_by_window:
        for timestamp, value in kept:
            yearly.setdefault(timestamp.year, []).append((timestamp, value))
    for timestamp, value in test_points:
        yearly.setdefault(timestamp.year, []).append((timestamp, value))
    yearly = {year: sorted(points) for year, points in yearly.items()}
    loyo = []
    for year in sorted(yearly):
        held_out = yearly[year]
        if len(held_out) < 2000:
            continue
        train = [
            point for other_year, points in yearly.items() if other_year != year
            for point in points
        ]
        year_fit = fit_constituents(train, speeds, compute_residuals=False)
        year_stats = height_stats(
            held_out, year_fit["constants"], year_fit["meanSeaLevel"], speeds)
        # Z29: the time envelope gets the same treatment. A storm moves the
        # observed extremum by an hour; a single year does not bound it.
        year_extrema = extrema_metrics(
            station_id, year_fit["constants"], year_fit["meanSeaLevel"], speeds,
            held_out[0][0].strftime("%Y-%m-%d"),
            held_out[-1][0].strftime("%Y-%m-%d"),
            use_cache)
        entry = {"year": year, **year_stats, "extrema": year_extrema}
        entry["maxMinutes"] = round(max(
            year_extrema["low"]["maxMinutes"] or 0.0,
            year_extrema["high"]["maxMinutes"] or 0.0), 2)
        loyo.append(entry)
        log(f"[{station_id}] LOYO {year}: n={year_stats['samples']} "
            f"max under-prediction {year_stats['maxUnderPredictionMeters']} m, "
            f"max |dt| {entry['maxMinutes']} min "
            f"({year_extrema.get('worst')}), "
            f"RMSE {year_stats['rmseMeters']} m")
    loyo_worst = max(
        loyo, key=lambda entry: entry["maxUnderPredictionMeters"] or 0.0) if loyo else None
    loyo_max_under = (loyo_worst or {}).get("maxUnderPredictionMeters") or 0.0
    loyo_worst_time = max(
        loyo, key=lambda entry: entry["maxMinutes"] or 0.0) if loyo else None
    loyo_max_time = (loyo_worst_time or {}).get("maxMinutes") or 0.0

    # Z30: RMSE is a series property. A stormy year at 0.21 m is weather, not a
    # regression; judge the median and cap the worst year.
    loyo_rmse = [entry["rmseMeters"] for entry in loyo if entry["rmseMeters"] is not None]
    series_rmse_median = median(loyo_rmse) if loyo_rmse else None
    series_rmse_max = max(loyo_rmse) if loyo_rmse else None
    series_rmse_ok = bool(
        series_rmse_median is not None
        and series_rmse_median <= 0.20
        and series_rmse_max <= 0.22)
    if loyo_rmse:
        log(f"[{station_id}] LOYO RMSE median {series_rmse_median:.4f} m, "
            f"max {series_rmse_max:.4f} m, series rule "
            f"{'pass' if series_rmse_ok else 'FAIL'}")
    if shipping and not series_rmse_ok:
        die(f"station {station_id}: LOYO RMSE series rule failed "
            f"(median {series_rmse_median:.4f} > 0.20 or max "
            f"{series_rmse_max:.4f} > 0.22)")

    # D2 consistency rule (Z22/Z29): leave-one-year-out max |dt| + 10 min, or
    # the stricter external cross-check when the station has one. The declared
    # envelope must cover it. The rule applies to **shipping** stations only:
    # station 3 feeds the coefficient, no spot ships on it.
    # Z29: u_t is sized on the leave-one-year-out maximum |dt|, not on the
    # neutral held-out year; the SHOM cross-check remains a second constraint.
    required_time = loyo_max_time + TIME_ALLOWANCE_MINUTES
    external = config.get("externalTimeCheckMinutes")
    if external is not None:
        required_time = max(
            required_time, external + config["externalTimeAllowanceMinutes"])
    declared_time = config["uncertainty"]["timeMinutes"]
    declared_height = config["uncertainty"]["heightMeters"]
    if shipping and declared_time < required_time:
        die(f"station {station_id}: declared u_t {declared_time} min < required "
            f"{required_time:.2f} min (LOYO max |dt| {loyo_max_time:.2f} in "
            f"{loyo_worst_time['year'] if loyo_worst_time else 'n/a'} + "
            f"{TIME_ALLOWANCE_MINUTES:.0f} min)")

    # Z21/Z27: one-sided height bound, sized on the leave-one-year-out maximum,
    # not on a single neutral year.
    required_height = loyo_max_under + HEIGHT_ALLOWANCE_METERS
    if shipping and declared_height < required_height:
        die(f"station {station_id}: declared u_h {declared_height} m < required "
            f"{required_height:.3f} m (LOYO max under-prediction "
            f"{loyo_max_under} in {loyo_worst['year'] if loyo_worst else 'n/a'} "
            f"+ {HEIGHT_ALLOWANCE_METERS} m)")

    if not shipping:
        basis = "coefficient reference only; no spot ships on station 3"
    else:
        basis = (
            f"u_t: leave-one-year-out max |dt| {loyo_max_time:.2f} min "
            f"({loyo_worst_time['year'] if loyo_worst_time else 'n/a'}) "
            f"+ {TIME_ALLOWANCE_MINUTES:.0f} min allowance (D2) = "
            f"{loyo_max_time + TIME_ALLOWANCE_MINUTES:.2f} min")
        if external is not None:
            basis += (
                f"; {config['externalTimeSource']} {external:.1f} min + "
                f"{config['externalTimeAllowanceMinutes']:.0f} min allowance (Z19)")
        basis += (
            f"; u_h: leave-one-year-out max under-prediction {loyo_max_under:.4f} m "
            f"({loyo_worst['year'] if loyo_worst else 'n/a'}) "
            f"+ {HEIGHT_ALLOWANCE_METERS:.2f} m minimum allowance (D2); "
            f"declared {declared_height:.2f} m "
            f"(margin {declared_height - loyo_max_under:.4f} m)")

    # Z25: forward test. Fit on the pre-2025 windows only, predict the 2026
    # half-year. Z26: this is an **anomalous-year stress test**, not a horizon
    # measurement. January 2026 mean pressure at Arcachon was 1007.9 hPa against
    # 1027.6 hPa in January 2022 (~+0.20 m of sea level from atmospheric
    # loading). A harmonic model does not predict weather; the bias is the
    # anomaly, and u_h carries the annual dispersion.
    forward_fit_points = [
        point for (start, _), kept in kept_by_window
        if parse_day(start).year <= 2024
        for point in kept
    ]
    forward_windows = [
        (start, end) for start, end in config["fit"] if parse_day(start).year == 2026
    ]
    forward_test = None
    if forward_fit_points and forward_windows:
        forward_fit = fit_constituents(
            forward_fit_points, speeds, compute_residuals=False)
        forward_start, forward_end = forward_windows[0]
        forward_points, forward_expected = fetch_range(
            station_id, 4, forward_start, forward_end, use_cache)
        assert_gaps(forward_points, station_id, f"forward {forward_start}..{forward_end}")
        forward_stats = height_stats(
            forward_points, forward_fit["constants"], forward_fit["meanSeaLevel"], speeds)
        forward_extrema = extrema_metrics(
            station_id, forward_fit["constants"], forward_fit["meanSeaLevel"], speeds,
            forward_start, forward_end, use_cache)
        forward_ok = within_d2(
            forward_stats, forward_extrema, declared_time, declared_height) if shipping else None

        # A true one-year extrapolation: the same pre-2025 fit, evaluated on the
        # held-out 2025 year. This is the regime the app will actually run in
        # right after launch (fit end 2026-06, launch 2026-10).
        one_year_stats = height_stats(
            test_points, forward_fit["constants"], forward_fit["meanSeaLevel"], speeds)
        one_year_extrema = extrema_metrics(
            station_id, forward_fit["constants"], forward_fit["meanSeaLevel"], speeds,
            test_start, test_end, use_cache)
        one_year_ok = within_d2(
            one_year_stats, one_year_extrema, declared_time, declared_height) if shipping else None

        # Z28: the horizon bounds astronomical decay (nodal drift), not the
        # annual weather dispersion. A bad stress year does not shorten it; u_h
        # covers that dispersion. The horizon is fit end + 3 years for all
        # stations, and the annual regeneration is a maintenance ritual.
        forward_test = {
            "fitWindows": [
                {"start": start, "end": end} for start, end in config["fit"]
                if parse_day(start).year <= 2024
            ],
            "testWindow": {"start": forward_start, "end": forward_end},
            **forward_stats,
            "extrema": forward_extrema,
            "withinD2": forward_ok,
            "interpretation": (
                "Anomalous-year stress test (Z26): January 2026 mean pressure "
                "1007.9 hPa vs 1027.6 hPa in January 2022 at Arcachon (~+0.20 m "
                "of sea level from atmospheric loading). A harmonic model does "
                "not predict this; the bias is weather, not model drift."),
            "pressureAnomaly": {
                "january2022Hectopascals": 1027.6,
                "january2025Hectopascals": 1016.8,
                "january2026Hectopascals": 1007.9,
                "equivalentSeaLevelMeters": 0.20,
                "source": "architect measurement, review v6 (Z26)",
            },
            "oneYearAhead": {
                "testWindow": {"start": test_start, "end": test_end},
                **one_year_stats,
                "extrema": one_year_extrema,
                "withinD2": one_year_ok,
            },
        }
        log(f"[{station_id}] forward {forward_start}..{forward_end}: "
            f"RMSE {forward_stats['rmseMeters']} m, bias {forward_stats['biasMeters']:+} m, "
            f"p95 |dh| {forward_stats['p95HeightErrorMeters']} m, "
            f"max under-prediction {forward_stats['maxUnderPredictionMeters']} m, "
            f"D2 {'n/a' if forward_ok is None else ('pass' if forward_ok else 'FAIL')}")
        log(f"[{station_id}] one-year ahead {test_start}..{test_end}: "
            f"RMSE {one_year_stats['rmseMeters']} m, bias {one_year_stats['biasMeters']:+} m, "
            f"p95 |dh| {one_year_stats['p95HeightErrorMeters']} m, "
            f"D2 {'n/a' if one_year_ok is None else ('pass' if one_year_ok else 'FAIL')}")
    m2 = constants["M2"]["amplitude"]
    s2 = constants["S2"]["amplitude"]
    mean_spring_range = 2 * (m2 + s2)

    fit_end = max(parse_day(end) for _, end in config["fit"])
    valid_until = datetime(fit_end.year + 3, fit_end.month, fit_end.day,
                           23, 59, 59, tzinfo=UTC)

    station = {
        "id": station_id,
        "name": config["name"],
        "role": config["role"],
        "coordinate": {
            "latitude": float(detail["latitude"]),
            "longitude": float(detail["longitude"]),
        },
        "timezoneIdentifier": config["timezone"],
        "meanSeaLevel": round(mean, 4),
        "meanSpringRange": round(mean_spring_range, 4),
        "constituents": [
            {
                "symbol": symbol,
                "amplitude": round(constants[symbol]["amplitude"], 5),
                "phaseDegrees": round(constants[symbol]["phaseDegrees"], 4),
            }
            for symbol in CONSTITUENTS
        ],
        "validUntil": iso(valid_until),
        "nodalCorrections": False,
        "attribution": ATTRIBUTION,
        "fitWindows": [{"start": start, "end": end} for start, end in config["fit"]],
        "excludedWindows": config["excluded"],
        "uncertainty": dict(config["uncertainty"]),
        "uncertaintyBasis": basis,
        "qc": [report.as_dict() for report in qc_reports],
        "accuracy": {
            "testWindow": {"start": test_start, "end": test_end},
            **stats,
            "extrema": extrema,
            "leaveOneYearOut": loyo,
            "seriesRmse": {
                "medianMeters": round(series_rmse_median, 5)
                if series_rmse_median is not None else None,
                "maxMeters": round(series_rmse_max, 5)
                if series_rmse_max is not None else None,
                "rule": "median <= 0.20 and max <= 0.22 (Z30)",
                "passed": series_rmse_ok,
            },
            "forwardTest": forward_test,
        },
    }

    return station



